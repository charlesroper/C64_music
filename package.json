{
  "name": "galway-2664",
  "version": "2026.11.11.2",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Galway 2664: Cycle-accurate MOS 6510 and 6581/8580 SID emulator for Ocean's 1985-87 C64 soundtracks, with a live assembler.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:lint": "biome check .",
    "format": "biome check --write .",
    "check:help-popovers": "node scripts/check_help_popovers.mjs",
    "hooks:install": "node scripts/install_hooks.mjs",
    "bump": "node scripts/bump_version.mjs",
    "deploy": "node scripts/deploy.mjs",
    "issue:close": "node scripts/close_issue.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
